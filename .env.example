# Infrastructure
CHROMA_HOST=chromadb
CHROMA_PORT=8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mcp_qa
POSTGRES_USER=mcp_qa
POSTGRES_PASSWORD=

# Xray Cloud (test export)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_JQL=project = "YOUR_PROJECT"
XRAY_CSV_PATH=existing_tests/data/tests.csv

# Confluence (internal documentation)
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_JIRA_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# GitLab (user documentation)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_BRANCH=main
GITLAB_PATH=docs
